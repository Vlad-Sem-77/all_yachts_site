# Use the exact private PostgreSQL connection string from the hosting provider.
DATABASE_URL='postgresql://USER:PASSWORD@PRIVATE_DB_HOST:5432/DB_NAME'

# Set both to the public site domain.
SITE_HOST='example.com'
SITE_URL='https://example.com'

# Generate a new long random value for the production host.
SESSION_SECRET='replace-with-a-long-random-value'
ADMIN_USERNAME='replace-with-admin-login'
ADMIN_PASSWORD='replace-with-a-strong-unique-password'

# Production Clerk keys for the exact domain configured in the Clerk instance.
CLERK_PUBLISHABLE_KEY='pk_live_replace-me'
CLERK_SECRET_KEY='sk_live_replace-me'
VITE_CLERK_PROXY_URL='/api/__clerk'

# S3-compatible storage credentials from the hosting provider.
OBJECT_STORAGE_DRIVER='s3'
S3_ENDPOINT_URL='https://s3-endpoint-from-provider'
S3_REGION='region-from-provider'
S3_BUCKET='bucket-name-from-provider'
S3_ACCESS_KEY_ID='replace-me'
S3_SECRET_ACCESS_KEY='replace-me'
S3_PREFIX='all-yachts'
S3_FORCE_PATH_STYLE='true'

# SMTP is optional. Without it, email notifications are disabled.
SMTP_HOST=''
SMTP_PORT=''
SMTP_USER=''
SMTP_PASS=''
SMTP_FROM=''
