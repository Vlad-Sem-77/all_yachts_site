<section class="category-hero">
  <nav class="breadcrumbs" aria-label="<%= t('accessibility.breadcrumb') %>">
    <a href="/"><%= t('nav.home') %></a>
    <span aria-hidden="true">/</span>
    <% if (category.parentId) { %>
      <a href="/category/<%= categories.find((item) => item.id === category.parentId)?.slug %>"><%= categories.find((item) => item.id === category.parentId)?.nameRu %></a>
      <span aria-hidden="true">/</span>
    <% } %>
    <span aria-current="page"><%= category.nameRu %></span>
  </nav>
  <p class="eyebrow"><%= t('nav.categories') %></p>
  <h1><%= category.nameRu %></h1>
  <p><%= category.descriptionRu || t('category.description', { name: category.nameRu }) %></p>
</section>

<% if (category.children.length) { %>
  <section class="content-section subcategory-section">
    <div class="section-heading">
      <div><p class="eyebrow"><%= t('category.subcategories') %></p><h2><%= t('category.subcategories') %></h2></div>
    </div>
    <div class="subcategory-grid">
      <% category.children.forEach((child) => { %>
        <a class="subcategory-card" href="/category/<%= category.slug %>/<%= child.slug %>">
          <span><%= child.nameRu %></span><span aria-hidden="true">→</span>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>

<section class="content-section category-listings">
  <div class="section-heading">
    <div><p class="eyebrow"><%= t('category.listingsHeading') %></p><h2><%= t('category.listingsHeading') %></h2></div>
    <span class="listing-total"><%= total %> <%= t('category.listingsCount', { count: total }) %></span>
  </div>
  <%- include("_catalog-filters", { filters, filterAction }) %>
  <%- include("_catalog-results", { listings, formatPrice, emptyMessage: t('category.emptyDescription'), emptyTitle: t('category.emptyTitle') }) %>
  <%- include("_pagination", { pagination }) %>
</section>
