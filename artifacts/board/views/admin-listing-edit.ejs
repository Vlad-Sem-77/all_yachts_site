<section class="page-heading compact-heading admin-heading">
  <p class="eyebrow"><%= t("admin.eyebrow") %></p>
  <h1><%= t("admin.editListing") %></h1>
  <%- include("_admin-nav") %>
</section>
<section class="content-section admin-content">
  <% if (editError) { %><div class="form-alert" role="alert"><%= editError %></div><% } %>
  <form class="listing-form admin-edit-form" method="post" action="/admin/listings/<%= listing.id %>/edit">
    <input type="hidden" name="_csrf" value="<%= csrf %>" />
    <label class="form-field"><span><%= t("submit.title") %></span><input name="title" maxlength="120" required value="<%= values.title ?? listing.title %>" /></label>
    <label class="form-field"><span><%= t("submit.category") %></span>
      <select name="categoryId" required>
        <% categoryOptions.forEach((category) => { %><option value="<%= category.id %>" <%= String(values.categoryId ?? listing.categoryId) === String(category.id) ? "selected" : "" %>><%= category.pathLabel %></option><% }) %>
      </select>
    </label>
    <label class="form-field"><span><%= t("submit.description") %></span><textarea name="description" rows="10" maxlength="10000" required><%= values.description ?? listing.description %></textarea></label>
    <div class="form-grid form-grid-two">
      <label class="form-field"><span><%= t("submit.price") %></span><input type="number" name="price" min="0" max="9999999999.99" step="0.01" value="<%= values.priceText ?? listing.price ?? "" %>" /></label>
      <label class="form-field"><span><%= t("submit.currency") %></span>
        <select name="currency" required>
          <% config.currencies.forEach((currency) => { %><option value="<%= currency.code %>" <%= String(values.currency ?? listing.currency) === currency.code ? "selected" : "" %>><%= currency.code %> · <%= currency.symbol %></option><% }) %>
        </select>
      </label>
      <label class="form-field"><span><%= t("submit.country") %></span><input name="country" maxlength="100" required value="<%= values.country ?? listing.country %>" /></label>
      <label class="form-field"><span><%= t("submit.city") %></span><input name="cityOrRegion" maxlength="100" required value="<%= values.cityOrRegion ?? listing.cityOrRegion %>" /></label>
    </div>
    <button class="primary-button" type="submit"><%= t("admin.saveListing") %></button>
    <a class="text-link" href="/admin/listings"><%= t("admin.backToListings") %></a>
  </form>
</section>
