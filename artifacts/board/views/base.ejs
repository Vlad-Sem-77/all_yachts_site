<!doctype html>
<html lang="<%= lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= description || t('home.description') %>" />
    <meta property="og:title" content="<%= title || t('home.title') %>" />
    <meta property="og:description" content="<%= description || t('home.description') %>" />
    <meta property="og:type" content="website" />
    <title><%= title || t('home.title') %></title>
    <link rel="stylesheet" href="/assets/site.css" />
    <link rel="stylesheet" href="/assets/listing.css" />
    <link rel="icon" href="/assets/emblem.png" type="image/png" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-inner">
          <a class="brand" href="/" aria-label="<%= t('nav.home') %>">
            <img class="brand-mark" src="/assets/emblem.png" alt="" />
            <span class="brand-name"><%= t('brand.name') %><small><%= t('brand.tagline') %></small></span>
          </a>
          <nav class="main-nav" aria-label="<%= t('accessibility.mainNavigation') %>">
            <a href="/#categories"><%= t('nav.categories') %></a>
            <a class="nav-submit" href="/submit"><%= t('nav.submit') %><span aria-hidden="true">＋</span></a>
          </nav>
        </div>
      </header>
      <main id="main-content">
        <%- body %>
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <div>
            <a class="footer-brand" href="/"><%= t('brand.name') %></a>
            <p><%= t('footer.tagline') %></p>
          </div>
          <div class="footer-categories">
            <strong><%= t('footer.categories') %></strong>
            <div>
              <% categories.forEach((category) => { %>
                <a href="/category/<%= category.slug %>"><%= category.nameRu %></a>
              <% }) %>
            </div>
          </div>
        </div>
      </footer>
    </div>
    <script src="/assets/interaction.js" defer></script>
  </body>
</html>
