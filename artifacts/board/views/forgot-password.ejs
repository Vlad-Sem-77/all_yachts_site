<section class="page-heading compact-heading">
  <nav class="breadcrumbs" aria-label="<%= t('accessibility.breadcrumb') %>">
    <a href="/"><%= t("nav.home") %></a><span aria-hidden="true">/</span>
    <a href="/listing/<%= listingSlug %>/manage"><%= t("detail.manageTitle") %></a><span aria-hidden="true">/</span>
    <span aria-current="page"><%= t("detail.resetTitle") %></span>
  </nav>
  <p class="eyebrow"><%= t("detail.authorTools") %></p>
  <h1><%= t("detail.resetTitle") %></h1>
  <p><%= t("detail.resetRequest") %></p>
</section>
<section class="content-section form-section">
  <form class="listing-form compact-form" method="post" action="/listing/<%= listingSlug %>/forgot-password">
    <% if (error) { %><div class="form-alert" role="alert"><%= error %></div><% } %>
    <% if (notice) { %><div class="notice-banner" role="status"><%= notice %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrf %>" />
    <label class="honeypot-field" aria-hidden="true"><span><%= t("submit.honeypotLabel") %></span><input name="website" tabindex="-1" autocomplete="off" /></label>
    <button class="primary-button" type="submit"><%= t("detail.sendReset") %></button>
  </form>
</section>
