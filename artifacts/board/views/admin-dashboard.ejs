<section class="page-heading compact-heading admin-heading">
  <p class="eyebrow"><%= t("admin.eyebrow") %></p>
  <h1><%= t("admin.dashboard") %></h1>
  <%- include("_admin-nav") %>
</section>
<section class="content-section admin-content">
  <div class="admin-stats-grid">
    <article class="admin-stat"><span><%= t("admin.totalListings") %></span><strong><%= stats.totalListings %></strong></article>
    <article class="admin-stat"><span><%= t("admin.activeListings") %></span><strong><%= stats.activeListings %></strong></article>
    <article class="admin-stat"><span><%= t("admin.hiddenListings") %></span><strong><%= stats.hiddenListings %></strong></article>
    <article class="admin-stat"><span><%= t("admin.expiredListings") %></span><strong><%= stats.expiredListings %></strong></article>
    <article class="admin-stat"><span><%= t("admin.newToday") %></span><strong><%= stats.newToday %></strong></article>
    <article class="admin-stat"><span><%= t("admin.newWeek") %></span><strong><%= stats.newWeek %></strong></article>
    <article class="admin-stat"><span><%= t("admin.views") %></span><strong><%= stats.views ?? 0 %></strong></article>
    <a class="admin-stat admin-stat-link" href="/admin/reports"><span><%= t("admin.pendingReports") %></span><strong><%= stats.pendingReports %></strong></a>
  </div>

  <section class="admin-panel">
    <div class="section-heading">
      <div><p class="eyebrow"><%= t("admin.categories") %></p><h2><%= t("admin.listingsByCategory") %></h2></div>
    </div>
    <% if (categoryStats.length) { %>
      <div class="admin-category-stats">
        <% categoryStats.forEach((category) => { %>
          <a href="/admin/listings?category=<%= category.id %>"><span><%= category.nameRu %></span><strong><%= category.total %></strong></a>
        <% }) %>
      </div>
    <% } else { %><p class="admin-muted"><%= t("admin.noCategories") %></p><% } %>
  </section>
</section>
