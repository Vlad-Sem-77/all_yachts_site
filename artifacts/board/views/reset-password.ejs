<section class="page-heading compact-heading">
  <p class="eyebrow"><%= t("detail.authorTools") %></p>
  <h1><%= t("detail.resetTitle") %></h1>
</section>
<section class="content-section form-section">
  <form class="listing-form compact-form" method="post" action="/reset-password">
    <% if (error) { %><div class="form-alert" role="alert"><%= error %></div><% } %>
    <% if (token) { %>
      <input type="hidden" name="_csrf" value="<%= csrf %>" />
      <input type="hidden" name="token" value="<%= token %>" />
      <label class="form-field"><span><%= t("detail.resetNewPassword") %></span><input type="password" name="newPassword" minlength="4" maxlength="72" autocomplete="new-password" required /></label>
      <button class="primary-button" type="submit"><%= t("detail.resetPasswordSubmit") %></button>
    <% } %>
  </form>
</section>
