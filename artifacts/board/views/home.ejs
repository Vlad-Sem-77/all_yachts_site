<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><%= t('home.eyebrow') %></p>
    <h1><%= t('home.headline') %></h1>
    <p class="hero-description"><%= t('home.subheadline') %></p>
    <form class="home-search" action="/search" method="get" role="search">
      <label class="visually-hidden" for="home-search"><%= t('search.query') %></label>
      <input id="home-search" name="q" type="search" maxlength="100" placeholder="<%= t('search.placeholder') %>" />
      <button class="primary-button" type="submit"><%= t('search.submit') %></button>
    </form>
    <div class="hero-actions" aria-label="Основные действия">
      <a class="hero-action hero-action-primary" href="/categories">Смотреть объявления<span aria-hidden="true">→</span></a>
      <a class="hero-action" href="/submit">Подать объявление<span aria-hidden="true">＋</span></a>
      <a class="hero-action" href="/forum">Пообщаться<span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero-illustration" aria-hidden="true">
    <div class="hero-medallion">
      <img src="/assets/emblem.png" alt="" />
    </div>
    <span class="hero-coordinate">Море начинается здесь</span>
  </div>
</section>

<section class="content-section latest-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><%= t('home.latestHeading') %></p>
      <h2><%= t('home.latestHeading') %></h2>
    </div>
  </div>
  <% if (listings.length) { %>
    <div class="listing-grid">
      <% listings.forEach((listing) => { %>
        <a class="listing-card" href="/category/<%= listing.categoryPath %>/<%= listing.slug %>">
          <div class="listing-card-image">
            <% if (listing.thumbnailUrl) { %><img src="<%= listing.thumbnailUrl %>" alt="" loading="lazy" /><% } else { %><span><%= t('listing.photoComingSoon') %></span><% } %>
          </div>
          <div class="listing-card-body">
            <h3><%= listing.title %></h3>
            <p class="listing-location"><%= listing.country %><%= t('listing.locationSeparator') %><%= listing.cityOrRegion %></p>
            <strong class="listing-price"><%= formatPrice(listing.price, listing.currency, listing.isNegotiable, t) %></strong>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <span class="empty-mark" aria-hidden="true">⌁</span>
      <div>
        <h3><%= t('home.emptyTitle') %></h3>
        <p><%= t('home.emptyDescription') %></p>
      </div>
    </div>
  <% } %>
</section>
